# 누니온다 (production-pipeline-system) 로컬 개발 환경 변수
# 복사해서 .env 로 사용: cp .env.example .env

# ─── Database (SQLite — local-first, no external server needed) ─────
# Prisma SQLite URL form. 파일 경로는 프로젝트 루트 기준.
DATABASE_URL="file:./dev.db"

# ─── NextAuth ─────────────────────────────────────────────────────
# 임의의 안전한 문자열 (production에서는 반드시 교체).
# 생성: openssl rand -base64 32
NEXTAUTH_SECRET="dev-secret-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# ─── (선택) AI 분석 — Gemini Free Tier ─────────────────────────────
# 시나리오 자동 분석 기능을 쓸 때만 필요. 미설정 시 분석 기능 비활성.
# GOOGLE_API_KEY=""
