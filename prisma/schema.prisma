generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ──────────────────────────────────────────────
// Auth (NextAuth.js)
// ──────────────────────────────────────────────

model User {
  id             String    @id @default(cuid())
  name           String
  email          String    @unique
  hashedPassword String
  role           UserRole  @default(STAFF)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  projects       ProjectMember[]
  auditLogs      AuditLog[]
  sessions       Session[]
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum UserRole {
  ADMIN        // 시스템 관리자
  PD           // PD/연출
  AD           // 조감독/PM
  ART_DIRECTOR // 프로덕션 디자이너
  STAFF        // 일반 스태프
}

// ──────────────────────────────────────────────
// Project (프로젝트)
// ──────────────────────────────────────────────

model Project {
  id          String       @id @default(cuid())
  title       String
  format      ProjectFormat
  platform    String?      // 방송사/OTT 플랫폼
  phase       ProjectPhase @default(DEVELOPMENT)
  description String?
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Relations
  members     ProjectMember[]
  scripts     Script[]
  schedules   Schedule[]
  budgetLines BudgetLine[]
  auditLogs   AuditLog[]

  // Project-level entities (M:N with Scene)
  characters  Character[]
  props       Prop[]
  costumes    Costume[]
  locations   Location[]
  vfxItems    VFX[]
}

model ProjectMember {
  id        String     @id @default(cuid())
  projectId String
  userId    String
  role      MemberRole
  createdAt DateTime   @default(now())

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

enum ProjectFormat {
  DRAMA        // 드라마
  FILM         // 영화
  VARIETY      // 예능
  DOCUMENTARY  // 다큐멘터리
  SHORT        // 단편
  WEB_DRAMA    // 웹드라마
  OTHER        // 기타
}

enum ProjectPhase {
  DEVELOPMENT     // 기획
  PRE_PRODUCTION  // 프리프로덕션
  PRODUCTION      // 촬영
  POST_PRODUCTION // 포스트프로덕션
  DELIVERY        // 납품
  COMPLETED       // 완료
}

enum MemberRole {
  PD              // PD/연출
  AD              // 조감독
  WRITER          // 작가
  ART_DIRECTOR    // 미술감독
  DOP             // 촬영감독
  LIGHTING        // 조명감독
  SOUND           // 사운드
  EDITOR          // 편집
  VFX_SUPERVISOR  // VFX 슈퍼바이저
  PRODUCER        // 프로듀서
  PRODUCTION_MANAGER // 제작부장
  STAFF           // 일반 스태프
}

// ──────────────────────────────────────────────
// 기획 (Development)
// ──────────────────────────────────────────────

model BudgetLine {
  id              String  @id @default(cuid())
  projectId       String
  category        String  // 인건비, 장비, 장소, 식비, 기타
  description     String
  estimatedAmount Int     // KRW 원 단위
  actualAmount    Int     @default(0)
  phase           ProjectPhase

  project         Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ──────────────────────────────────────────────
// 프리프로덕션 (Pre-production)
// ──────────────────────────────────────────────

model Script {
  id             String         @id @default(cuid())
  projectId      String
  title          String
  uploadedFile   String?        // 파일 경로
  parsedText     String?        // 추출된 텍스트
  analysisStatus AnalysisStatus @default(PENDING)
  version        Int            @default(1)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  project        Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scenes         Scene[]
  analysisJobs   AnalysisJob[]
}

model Scene {
  id          String   @id @default(cuid())
  scriptId    String
  number      Int
  intExt      IntExt
  location    String   // 장소 이름 (대본 기준)
  timeOfDay   TimeOfDay
  description String?
  pageCount   Float?   // 페이지 수 (1/8 단위)
  sortOrder   Int      @default(0)

  script      Script   @relation(fields: [scriptId], references: [id], onDelete: Cascade)

  // M:N relations via join tables
  characters  SceneCharacter[]
  props       SceneProp[]
  costumes    SceneCostume[]
  locations   SceneLocation[]
  vfxItems    SceneVFX[]

  // 1:N
  shots         Shot[]
  sceneStatuses SceneStatus[]
  fieldChanges  FieldChange[]

  @@unique([scriptId, number])
}

enum IntExt {
  INT   // 실내
  EXT   // 실외
  INT_EXT // 실내/실외
}

enum TimeOfDay {
  D     // 낮
  N     // 밤
  DN    // 저녁 (D/N)
  ND    // 새벽 (N/D)
}

enum AnalysisStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// Project-level entities

model Character {
  id          String  @id @default(cuid())
  projectId   String
  name        String
  description String?

  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scenes      SceneCharacter[]

  @@unique([projectId, name])
}

model Prop {
  id        String    @id @default(cuid())
  projectId String
  name      String
  status    PropStatus @default(UNACQUIRED)

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scenes    SceneProp[]
  assetLogs DailyAssetLog[]

  @@unique([projectId, name])
}

model Costume {
  id          String        @id @default(cuid())
  projectId   String
  name        String
  character   String?       // 착용 캐릭터
  status      CostumeStatus @default(PREPARING)

  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scenes      SceneCostume[]
  assetLogs   DailyAssetLog[]

  @@unique([projectId, name])
}

model Location {
  id        String         @id @default(cuid())
  projectId String
  name      String         // 대본상 장소명
  realName  String?        // 실제 촬영 장소
  address   String?
  status    LocationStatus @default(UNCONFIRMED)

  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scenes    SceneLocation[]

  @@unique([projectId, name])
}

model VFX {
  id          String        @id @default(cuid())
  projectId   String
  description String
  complexity  VFXComplexity @default(MEDIUM)

  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scenes      SceneVFX[]
}

// Join tables (M:N)

model SceneCharacter {
  id          String    @id @default(cuid())
  sceneId     String
  characterId String
  action      String?   // 씬에서의 행동

  scene       Scene     @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([sceneId, characterId])
}

model SceneProp {
  id      String @id @default(cuid())
  sceneId String
  propId  String
  usage   String? // 사용 맥락

  scene   Scene  @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  prop    Prop   @relation(fields: [propId], references: [id], onDelete: Cascade)

  @@unique([sceneId, propId])
}

model SceneCostume {
  id        String  @id @default(cuid())
  sceneId   String
  costumeId String
  note      String?

  scene     Scene   @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  costume   Costume @relation(fields: [costumeId], references: [id], onDelete: Cascade)

  @@unique([sceneId, costumeId])
}

model SceneLocation {
  id         String   @id @default(cuid())
  sceneId    String
  locationId String
  note       String?

  scene      Scene    @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([sceneId, locationId])
}

model SceneVFX {
  id      String @id @default(cuid())
  sceneId String
  vfxId   String
  note    String?

  scene   Scene  @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  vfx     VFX    @relation(fields: [vfxId], references: [id], onDelete: Cascade)

  @@unique([sceneId, vfxId])
}

model Shot {
  id          String  @id @default(cuid())
  sceneId     String
  number      Int
  size        String? // CU, MS, WS, etc.
  angle       String?
  movement    String? // 팬, 틸트, 돌리 등
  description String?

  scene       Scene   @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  @@unique([sceneId, number])
}

// Enums for entity statuses

enum PropStatus {
  UNACQUIRED  // 미확보
  ACQUIRED    // 확보
  NOT_NEEDED  // 불요
}

enum CostumeStatus {
  PREPARING  // 준비중
  READY      // 완료
  REPAIRING  // 수선중
}

enum LocationStatus {
  UNCONFIRMED // 미확인
  SCOUTING    // 헌팅중
  CONFIRMED   // 확정
  UNAVAILABLE // 불가
}

enum VFXComplexity {
  LOW
  MEDIUM
  HIGH
}

// ──────────────────────────────────────────────
// 스케줄
// ──────────────────────────────────────────────

model Schedule {
  id        String       @id @default(cuid())
  projectId String
  title     String       @default("메인 스케줄")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  shootingDays ShootingDay[]
}

model ShootingDay {
  id           String   @id @default(cuid())
  scheduleId   String
  date         DateTime
  location     String?
  weatherPlan  String?  // 우천시 대안
  callTime     String?  // "06:00"
  shootTime    String?  // "08:00"
  notes        String?
  sortOrder    Int      @default(0)

  schedule     Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  // Relations
  callSheets    CallSheet[]
  dailyReports  DailyReport[]
  sceneStatuses SceneStatus[]
  fieldChanges  FieldChange[]
  assetLogs     DailyAssetLog[]
}

// ──────────────────────────────────────────────
// 촬영 (Production)
// ──────────────────────────────────────────────

model CallSheet {
  id            String      @id @default(cuid())
  shootingDayId String
  callTime      String      // "06:00"
  scenes        Json?       // 씬 목록 (참고용)
  cast          Json?       // 출연진 호출 정보
  crew          Json?       // 스태프 호출 정보
  equipment     Json?       // 장비 목록
  meals         Json?       // 식사 스케줄
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  shootingDay   ShootingDay @relation(fields: [shootingDayId], references: [id], onDelete: Cascade)
}

model DailyReport {
  id            String      @id @default(cuid())
  shootingDayId String
  setupCount    Int         @default(0)
  overtimeHours Float       @default(0)
  notes         String?
  createdAt     DateTime    @default(now())

  shootingDay   ShootingDay @relation(fields: [shootingDayId], references: [id], onDelete: Cascade)
}

model SceneStatus {
  id            String            @id @default(cuid())
  sceneId       String
  shootingDayId String
  status        ShootingStatus    @default(WAITING)
  takes         Int               @default(0)
  notes         String?

  scene         Scene             @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  shootingDay   ShootingDay       @relation(fields: [shootingDayId], references: [id], onDelete: Cascade)

  @@unique([sceneId, shootingDayId])
}

enum ShootingStatus {
  WAITING     // 대기
  SHOOTING    // 촬영중
  COMPLETED   // 완료
  RESHOOT     // 재촬영
}

model FieldChange {
  id            String           @id @default(cuid())
  shootingDayId String
  sceneId       String?
  changeType    FieldChangeType
  description   String
  approvedBy    String?          // 승인자 이름
  createdAt     DateTime         @default(now())

  shootingDay   ShootingDay      @relation(fields: [shootingDayId], references: [id], onDelete: Cascade)
  scene         Scene?           @relation(fields: [sceneId], references: [id], onDelete: SetNull)
}

enum FieldChangeType {
  DIALOGUE    // 대사 변경
  BLOCKING    // 동선 변경
  PROP        // 소품 변경
  SCENE_ADD   // 씬 추가
  SCENE_DELETE // 씬 삭제
  OTHER       // 기타
}

model DailyAssetLog {
  id            String          @id @default(cuid())
  shootingDayId String
  propId        String?
  costumeId     String?
  assetStatus   AssetLogStatus  @default(READY)
  notes         String?
  createdAt     DateTime        @default(now())

  shootingDay   ShootingDay     @relation(fields: [shootingDayId], references: [id], onDelete: Cascade)
  prop          Prop?           @relation(fields: [propId], references: [id], onDelete: SetNull)
  costume       Costume?        @relation(fields: [costumeId], references: [id], onDelete: SetNull)
}

enum AssetLogStatus {
  READY       // 준비완료
  IN_USE      // 사용중
  DAMAGED     // 손상
  LOST        // 분실
}

// ──────────────────────────────────────────────
// AI 분석 작업 큐
// ──────────────────────────────────────────────

model AnalysisJob {
  id         String         @id @default(cuid())
  scriptId   String
  status     AnalysisStatus @default(PENDING)
  chunkIndex Int?           // 청크 분할 인덱스
  chunkTotal Int?           // 전체 청크 수
  result     Json?          // 분석 결과
  error      String?
  retryCount Int            @default(0)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  script     Script         @relation(fields: [scriptId], references: [id], onDelete: Cascade)
}

// ──────────────────────────────────────────────
// 감사 로그
// ──────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  projectId  String?
  action     String   // CREATE, UPDATE, DELETE
  entityType String   // Project, Scene, CallSheet, etc.
  entityId   String
  oldValue   Json?
  newValue   Json?
  timestamp  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id])
  project    Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([projectId, timestamp])
  @@index([entityType, entityId])
}
